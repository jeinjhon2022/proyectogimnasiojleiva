# Variables de entorno del proyecto.
# Ninguna es necesaria todavía en la Fase 1 (sin autenticación, base de datos ni servicios externos).
# Se documentan aquí desde ahora para dejar fijo el nombre esperado cuando cada fase las incorpore.
# Nunca completar este archivo con valores reales: usar secretos de Cloudflare o un .env local
# (ignorado por git) para eso.

# Fase 3 — Clerk (autenticación), plan Free
# La publishable key es PÚBLICA (Vite la expone al navegador; por eso lleva el prefijo VITE_).
VITE_CLERK_PUBLISHABLE_KEY=
# La secret key NUNCA va aquí ni lleva prefijo VITE_ — es un secreto del Worker.
# Local: ver .dev.vars.example. Remoto: `wrangler secret put CLERK_SECRET_KEY`.

# Fase 5 — Resend (correo de aviso de vencimiento de membresía), plan Free.
# RESEND_API_KEY es secreta: no va aquí. Ver .dev.vars.example (local) o
# `wrangler secret put RESEND_API_KEY` (remoto). El resto de correos transaccionales
# se agrega en la Fase 9.

# Fase 9 — Sentry (monitoreo de errores del frontend), plan Free.
# El DSN no es secreto (está pensado para ir en el bundle del navegador).
VITE_SENTRY_DSN=

# Fase 9 — Cloudflare Turnstile (protección contra bots), gratuito
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
